generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  OUTCOME
}

enum TransactionStatus {
  PAID
  PENDING
  SCHEDULED
  SCHEDULED_PAID
  PLANNED
}

enum RecurrenceOption {
  NONE
  MONTHLY
  YEARLY
}

enum NotificationType {
  ALERT
  AI
  BILLING
  GOAL
}

model User {
  id           String   @id @default(cuid())
  name         String  @db.VarChar(50)
  email        String   @unique
  passwordHash String  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  categories      Category[]
  transactions    Transaction[]
  budgets         Budget[]
  financialScores FinancialScore[]
  dashCards       UserDashCard[]
  aiInsights      AiInsight[]
  notifications   Notification[]

  @@map("users")
}

model Category {
  id       Int             @id @default(autoincrement())
  userId   String         @map("user_id")
  name     String          @db.VarChar(18)
  type     TransactionType
  icon     String          @db.VarChar(30)
  isCustom Boolean         @default(false) @map("is_custom")

  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  dashCards    UserDashCard[]

  @@index([userId, type])
  @@map("categories")
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  categoryId  Int               @map("category_id")
  name        String            @db.VarChar(100)
  amount      Decimal           @db.Decimal(12, 2)
  type        TransactionType
  status      TransactionStatus @default(PAID)
  date        DateTime          @default(now())  @db.Date
  dueDate     DateTime?          @map("due_date") @db.Date
  recurrence  RecurrenceOption  @default(NONE)
  parentId    String?           @map("parent_id")
  createdAt   DateTime          @default(now())  @map("created_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id])
  parent           Transaction?  @relation("TransactionRecurrence", fields: [parentId], references: [id], onDelete: SetNull)
  childOccurrences Transaction[] @relation("TransactionRecurrence")

  @@index([userId, date, type])
  @@index([userId, status, dueDate])
  @@map("transactions")
}

model Budget {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  categoryId      Int      @map("category_id")
  amountAllocated Decimal  @map("amount_allocated") @db.Decimal(12, 2)
  monthYear       String   @map("month_year")
  createdAt       DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, monthYear])
  @@map("budgets")
}

model FinancialScore {
  id                      String   @id @default(cuid())
  userId                  String   @map("user_id")
  totalScore              Int      @map("total_score")
  incomeVsOutcomeScore    Int      @default(0) @map("income_vs_outcome_score")
  planningAdherenceScore Int      @default(0) @map("planning_adherence_score")
  investmentScore         Int      @default(0) @map("investment_score")
  historyConsistencyScore Int      @default(0) @map("history_consistency_score")
  monthYear               String   @map("month_year") // Formato: '08-2026'
  createdAt               DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthYear])
  @@map("financial_scores")
}

model UserDashCard {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  title            String
  cardType         String   @map("card_type")
  targetAmount     Decimal? @map("target_amount") @db.Decimal(12, 2)
  filterCategoryId Int?     @map("filter_category_id")
  positionIndex    Int      @map("position_index")
  createdAt        DateTime @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filterCategory Category? @relation(fields: [filterCategoryId], references: [id], onDelete: SetNull)

  @@map("user_dash_cards")
}

model AiInsight {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  monthYear   String   @map("month_year")
  insightType String   @map("insight_type")
  title       String
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_insights")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  title     String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")
  expiresAt DateTime?        @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, read])
  @@map("notifications")
}
